# Server
PORT=7002
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=Suraj@1980
DB_DATABASE=school_erp_admin

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
.env
# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=school-erp-uploads

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── OTP / Login ────────────────────────────────────────────────
# A master OTP that always verifies — use for demos/QA without a live
# SMS/email gateway. LEAVE EMPTY IN PRODUCTION.
SUPER_OTP=123456
# When true, generated OTPs are returned in the API response (dev only).
# Defaults to true when NODE_ENV != production.
OTP_DEV_ECHO=true

# ─── Email (AWS SES) ────────────────────────────────────────────
# If AWS creds are blank, emails are logged instead of sent (dev-safe).
SES_FROM_EMAIL=no-reply@schoolerp.com

# ─── SMS gateway ────────────────────────────────────────────────
# SMS_PROVIDER: "log" (default, prints to console) or "http" (generic
# HTTP gateway). For "http", set SMS_API_URL with placeholders:
#   {phone} {message} {key} {sender}
# Example (MSG91-style):
#   SMS_API_URL=https://api.msg91.com/api/v5/flow/?mobiles={phone}&authkey={key}&...
SMS_PROVIDER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=SCHERP
DB_LOGGING=false
